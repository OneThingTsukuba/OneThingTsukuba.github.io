---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCalendarPanel from '../components/EventCalendarPanel.astro';
import '../styles/top.css';
import { getCalendarDashboard, parseLocation, type CalendarEvent } from '../lib/calendar';
import { formatPostDateLong, getSortedPosts } from '../lib/blog';
import {
  FOUNDER,
  FOUNDER_ID,
  NAV_ITEMS,
  OG_IMAGE_PATH,
  ORGANIZATION_ID,
  SITE_DESCRIPTION,
  SITE_NAME_FULL,
  SOCIAL_LINKS,
  WEBSITE_ID,
  absoluteUrl,
} from '../lib/site';

// 構造化データ用にイベントを取る。EventCalendarPanel と同じ関数で、結果はモジュール内でキャッシュされる。
const dashboard = await getCalendarDashboard(12, { sourceIds: ['onething'] });

const latestPosts = (await getSortedPosts()).slice(0, 3);

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORGANIZATION_ID,
  name: SITE_NAME_FULL,
  alternateName: ['OneThing', 'OneThing Tsukuba'],
  url: absoluteUrl('/'),
  description: SITE_DESCRIPTION,
  foundingDate: '2023',
  areaServed: '茨城県つくば市',
  sameAs: [SOCIAL_LINKS.x, SOCIAL_LINKS.luma, SOCIAL_LINKS.connpass, SOCIAL_LINKS.github],
  founder: {
    '@type': 'Person',
    '@id': FOUNDER_ID,
    name: FOUNDER.name,
    url: FOUNDER.url,
    sameAs: [...FOUNDER.sameAs],
  },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  name: SITE_NAME_FULL,
  url: absoluteUrl('/'),
  inLanguage: 'ja',
  publisher: { '@id': ORGANIZATION_ID },
};

const EVENT_FALLBACK_DESCRIPTIONS: Record<CalendarEvent['kind'], string> = {
  mokumoku: 'OneThing が週1回程度つくば市で開くもくもく会です。各自が手を動かして作業を進めます。初心者歓迎、参加費無料。',
  study: 'OneThing が月1回開く勉強会です。初心者歓迎、参加費無料。',
  lt: 'OneThing が不定期に開く LT会です。初心者歓迎、参加費無料。',
  project: 'OneThing（筑波大学エンジニアコミュニティ）のイベントです。初心者歓迎、参加費無料。',
  event: 'OneThing（筑波大学エンジニアコミュニティ）のイベントです。初心者歓迎、参加費無料。',
};

const eventPlace = (event: CalendarEvent) => {
  const { name, address } = parseLocation(event.location);

  return {
    '@type': 'Place',
    name: name || '茨城県つくば市',
    address: address
      ? { '@type': 'PostalAddress', addressCountry: 'JP', ...address }
      : {
          '@type': 'PostalAddress',
          addressLocality: 'つくば市',
          addressRegion: '茨城県',
          addressCountry: 'JP',
        },
  };
};

const organizationRef = {
  '@type': 'Organization',
  '@id': ORGANIZATION_ID,
  name: SITE_NAME_FULL,
  url: absoluteUrl('/'),
};

// Google のイベント リッチリザルト用。日時は ISO 8601 で渡す必要がある。
const eventsJsonLd = dashboard.events.map((event) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.summary,
  startDate: event.start.toISOString(),
  endDate: event.end.toISOString(),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: eventPlace(event),
  image: [absoluteUrl(OG_IMAGE_PATH)],
  description: event.shortDescription || EVENT_FALLBACK_DESCRIPTIONS[event.kind],
  organizer: organizationRef,
  performer: organizationRef,
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'JPY',
    availability: 'https://schema.org/InStock',
    url: event.url ?? SOCIAL_LINKS.luma,
  },
  ...(event.url ? { url: event.url } : {}),
}));

const faqItems = [
  {
    question: 'プログラミング初心者でも参加できますか？',
    answer:
      '参加できます。初心者向けのプログラミングワークショップも開いています。もくもく会は各自が手を動かす場なので、学びはじめの人でも入りやすい形式です。',
  },
  {
    question: '参加費はかかりますか？',
    answer: 'かかりません。LT会・勉強会・もくもく会はいずれも参加費無料です。',
  },
  {
    question: '筑波大学の学生でなくても参加できますか？',
    answer:
      '筑波大学の学生を中心としたコミュニティですが、つくば周辺で活動しているエンジニアの方も参加しています。まずはイベント一覧から気になる回に来てください。',
  },
  {
    question: '学類や学年の指定はありますか？',
    answer: 'ありません。情報系以外の学類の学生も参加しています。1年生の参加も歓迎です。',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title="OneThing｜筑波大学・つくばのエンジニアサークル・コミュニティ"
  description={SITE_DESCRIPTION}
  navItems={[...NAV_ITEMS]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    {eventsJsonLd.map((event) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(event)} />
    ))}
  </Fragment>

  <section class="hero">
    <div>
      <h1>筑波大学の<span class="accent">エンジニア</span>コミュニティ<br /> OneThing</h1>
      <p class="lead">週1回程度のもくもく会、月1回の勉強会、不定期のLT会。初心者歓迎、参加費無料。</p>
      <div class="cta" data-link-location="hero">
        <a class="btn" href={SOCIAL_LINKS.luma}>イベント一覧を見る</a>
        <a class="btn btn-ghost" href="/calender/">カレンダー</a>
      </div>
    </div>
    <div class="term" role="group" aria-label="OneThing の概要">
      <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <dl>
        <dt>拠点</dt><dd>茨城県つくば市</dd>
        <dt>活動開始</dt><dd>2023年</dd>
        <dt>もくもく会</dt><dd>週1回程度</dd>
        <dt>勉強会</dt><dd>月1回</dd>
        <dt>LT会</dt><dd>不定期</dd>
        <dt>参加費</dt><dd>無料</dd>
        <dt>入会手続き</dt><dd>なし</dd>
      </dl>
    </div>
  </section>

  <section id="onething">
    <h2>OneThingとは</h2>
    <p>
      2023年より活動している、筑波大学のエンジニアコミュニティです。つくば市を拠点に、週1回程度のもくもく会、月1回の勉強会、不定期のLT会を開いています。
    </p>
    <p>筑波大学の学生が運営するエンジニアサークルです（大学の公認団体ではありません）。</p>
  </section>

  <section id="purpose">
    <h2>OneThingの目的</h2>
    <p>1つの作品を通して次への一歩を踏み出し、仲間と共に挑戦ができる、筑波大学1番のエンジニアコミュニティを目指しています。</p>
  </section>

  <section id="activities">
    <h2>活動内容</h2>
    <ul class="activity-grid">
      <li class="activity-card">
        <h3>もくもく会</h3>
        <span class="activity-cadence">週1回程度</span>
        <p>各自が作りたいものを持ち寄って手を動かす会。途中参加も途中退出もできます。手を止めた雑談では、それぞれの専門に沿った技術の話が出ます。</p>
      </li>
      <li class="activity-card">
        <h3>勉強会</h3>
        <span class="activity-cadence">月1回</span>
        <p>知りたいことを、知っている人が話す形式。これまでのトピックは Claude Code の使い方と git command。</p>
      </li>
      <li class="activity-card">
        <h3>LT会</h3>
        <span class="activity-cadence">不定期</span>
        <p>1人5分の持ち時間で、作ったものを話す会。飛び入りの発表も歓迎しています。</p>
      </li>
    </ul>
    <p class="activity-note">
      このほかに、初心者向けプログラミングワークショップと、協賛企業とのプロジェクトがあります。
    </p>
    <EventCalendarPanel variant="overview" heading="直近の活動予定" headingId="top-event-calendar" />
  </section>

  {
    latestPosts.length > 0 && (
      <section id="latest-posts">
        <h2>最新の記事</h2>
        <ul class="link-rows">
          {latestPosts.map((post) => (
            <li>
              <a class="link-row" href={`/blog/${post.id}/`}>
                <span class="link-row-body">
                  <strong>{post.data.title}</strong>
                  <span>
                    <time datetime={post.data.pubDate.toISOString()}>{formatPostDateLong(post.data.pubDate)}</time>・{post.data.category}
                  </span>
                </span>
                <span class="link-row-action" aria-hidden="true">読む</span>
              </a>
            </li>
          ))}
          <li>
            <a class="link-row" href="/blog/">
              <span class="link-row-body">
                <strong>記事一覧</strong>
                <span>活動の紹介、開催報告、技術の解説</span>
              </span>
              <span class="link-row-action" aria-hidden="true">開く</span>
            </a>
          </li>
        </ul>
      </section>
    )
  }

  <section id="participation" class="join">
    <h2>OneThingへの参加方法</h2>
    <p>
      事前の入会手続きはありません。以下のイベント一覧から気になる回を選んで、当日来てください。
    </p>
    <div class="cta" data-link-location="join">
      <a class="btn" href={SOCIAL_LINKS.luma}>イベント一覧を見る</a>
      <a class="btn btn-ghost" href={SOCIAL_LINKS.x}>公式Xで問い合わせ</a>
    </div>
  </section>

  <section id="faq">
    <h2>よくある質問</h2>
    <dl class="faq-list">
      {faqItems.map((item) => (
        <Fragment>
          <dt>{item.question}</dt>
          <dd>{item.answer}</dd>
        </Fragment>
      ))}
    </dl>
  </section>

  <section id="management">
    <h2>運営体制</h2>
    <p>OneThingは、筑波大学の学生メンバーを中心に、イベント企画・広報・企業連携などを分担して運営しています。</p>
  </section>

  <section id="contact">
    <h2>お問い合わせ</h2>
    <p>
      <a href={SOCIAL_LINKS.x}>公式X（旧Twitter）</a>のDMにてお問い合わせください。
    </p>
  </section>
</BaseLayout>
