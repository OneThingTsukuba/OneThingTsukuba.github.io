---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/top.css';
import heroLt from '../assets/hero-lt.jpg';
import heroHackathon from '../assets/hero-hackathon.jpg';
import {
  buildUpcomingRows,
  buildSessionNote,
  formatFetchedAt,
  getCalendarDashboard,
  parseSessionNumber,
  parseLocation,
  type CalendarEvent,
} from '../lib/calendar';
import { formatPostDateLong, getSortedPosts } from '../lib/blog';
import {
  FOUNDER,
  FOUNDER_ID,
  NAV_ITEMS,
  OG_IMAGE_PATH,
  ORGANIZATION_ID,
  SITE_DESCRIPTION,
  SITE_NAME_FULL,
  SOCIAL_LINKS,
  WEBSITE_ID,
  absoluteUrl,
} from '../lib/site';

// 構造化データ用にイベントを取る。EventCalendarPanel と同じ関数で、結果はモジュール内でキャッシュされる。
const dashboard = await getCalendarDashboard(12, { sourceIds: ['onething'] });

const latestPosts = (await getSortedPosts()).slice(0, 3);

const heroPhotos = [
  {
    src: heroLt,
    alt: 'OneThing の LT会で、スライドを映して発表するメンバー',
    className: 'hero-photo hero-photo--main',
    widths: [480, 960, 1440],
    sizes: '(max-width: 900px) 100vw, 45vw',
    priority: 'high' as const,
  },
  {
    src: heroHackathon,
    alt: 'ハッカソンに参加した OneThing のメンバー',
    className: 'hero-photo hero-photo--sub',
    widths: [480, 960],
    sizes: '(max-width: 900px) 42vw, 27vw',
    priority: 'low' as const,
  },
];

const upcomingRows = buildUpcomingRows(dashboard.events, dashboard.fetchedAt);
const [nextMokumokuRow] = buildUpcomingRows(
  dashboard.events.filter((event) => event.kind === 'mokumoku'),
  dashboard.fetchedAt,
  1,
);
const sessionNumber = nextMokumokuRow ? parseSessionNumber(nextMokumokuRow.event.summary) : null;
const sessionNote = buildSessionNote(nextMokumokuRow, dashboard.fetchedAt);

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORGANIZATION_ID,
  name: SITE_NAME_FULL,
  alternateName: ['OneThing', 'OneThing Tsukuba'],
  url: absoluteUrl('/'),
  description: SITE_DESCRIPTION,
  foundingDate: '2023',
  areaServed: '茨城県つくば市',
  sameAs: [SOCIAL_LINKS.x, SOCIAL_LINKS.luma, SOCIAL_LINKS.connpass, SOCIAL_LINKS.github],
  founder: {
    '@type': 'Person',
    '@id': FOUNDER_ID,
    name: FOUNDER.name,
    url: FOUNDER.url,
    sameAs: [...FOUNDER.sameAs],
  },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  name: SITE_NAME_FULL,
  url: absoluteUrl('/'),
  inLanguage: 'ja',
  publisher: { '@id': ORGANIZATION_ID },
};

const EVENT_FALLBACK_DESCRIPTIONS: Record<CalendarEvent['kind'], string> = {
  mokumoku: 'OneThing が週1回程度つくば市で開くもくもく会です。各自が手を動かして作業を進めます。初心者歓迎、参加費無料。',
  study: 'OneThing が月1回開く勉強会です。初心者歓迎、参加費無料。',
  lt: 'OneThing が不定期に開く LT会です。初心者歓迎、参加費無料。',
  project: 'OneThing（筑波大学エンジニアコミュニティ）のイベントです。初心者歓迎、参加費無料。',
  event: 'OneThing（筑波大学エンジニアコミュニティ）のイベントです。初心者歓迎、参加費無料。',
};

const eventPlace = (event: CalendarEvent) => {
  const { name, address } = parseLocation(event.location);

  return {
    '@type': 'Place',
    name: name || '茨城県つくば市',
    address: address
      ? { '@type': 'PostalAddress', addressCountry: 'JP', ...address }
      : {
          '@type': 'PostalAddress',
          addressLocality: 'つくば市',
          addressRegion: '茨城県',
          addressCountry: 'JP',
        },
  };
};

const organizationRef = {
  '@type': 'Organization',
  '@id': ORGANIZATION_ID,
  name: SITE_NAME_FULL,
  url: absoluteUrl('/'),
};

// Google のイベント リッチリザルト用。日時は ISO 8601 で渡す必要がある。
const eventsJsonLd = dashboard.events.map((event) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.summary,
  startDate: event.start.toISOString(),
  endDate: event.end.toISOString(),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: eventPlace(event),
  image: [absoluteUrl(OG_IMAGE_PATH)],
  description: event.shortDescription || EVENT_FALLBACK_DESCRIPTIONS[event.kind],
  organizer: organizationRef,
  performer: organizationRef,
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'JPY',
    availability: 'https://schema.org/InStock',
    url: event.url ?? SOCIAL_LINKS.luma,
  },
  ...(event.url ? { url: event.url } : {}),
}));

const faqItems = [
  {
    question: 'プログラミング初心者でも参加できますか？',
    answer:
      '参加できます。初心者向けのプログラミングワークショップも開いています。もくもく会は各自が手を動かす場なので、学びはじめの人でも入りやすい形式です。',
  },
  {
    question: '参加費はかかりますか？',
    answer: 'かかりません。LT会・勉強会・もくもく会はいずれも参加費無料です。',
  },
  {
    question: '筑波大学の学生でなくても参加できますか？',
    answer:
      '筑波大学の学生を中心としたコミュニティですが、つくば周辺で活動しているエンジニアの方も参加しています。まずはイベント一覧から気になる回に来てください。',
  },
  {
    question: '学類や学年の指定はありますか？',
    answer: 'ありません。情報系以外の学類の学生も参加しています。1年生の参加も歓迎です。',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---


<BaseLayout
  title="OneThing｜筑波大学・つくばのエンジニアサークル・コミュニティ"
  description={SITE_DESCRIPTION}
  navItems={[...NAV_ITEMS]}
  fullBleed
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    {eventsJsonLd.map((event) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(event)} />
    ))}
  </Fragment>

  <section class="hero">
    <div class="hero-text">
      <p class="kicker">つくば市 / 学生運営のエンジニアサークル</p>
      <h1><span class="h1-sub">筑波大学のエンジニアコミュニティ</span>OneThing</h1>
      <p class="lead">週1回程度のもくもく会、月1回の勉強会、不定期のLT会。作りたいものを持ち寄って、手を動かす場です。プログラミング初心者歓迎、参加費は無料です。</p>
      <div class="cta" data-link-location="hero">
        <a class="btn" href={SOCIAL_LINKS.luma}>イベント一覧を見る</a>
        <a class="text-link" href={SOCIAL_LINKS.x}>公式X で聞いてみる</a>
      </div>
    </div>
    <div class="hero-photos">
      {heroPhotos.map((photo) => (
        <Image
          class={photo.className}
          src={photo.src}
          alt={photo.alt}
          widths={photo.widths}
          sizes={photo.sizes}
          loading="eager"
          fetchpriority={photo.priority}
        />
      ))}
      <p class="since num">2023<small>から活動しています</small></p>
    </div>
  </section>

  <section class="about" id="onething" aria-labelledby="about-heading">
    <h2 id="about-heading">1つ作って、<br />次の一歩へ。</h2>
    <div>
      <p class="about-lead">1つの作品を通して次への一歩を踏み出し、仲間と共に挑戦ができる、筑波大学1番のエンジニアコミュニティを目指しています。</p>
      <p>OneThing は2023年から活動している、筑波大学の学生が運営するエンジニアサークルです。大学の公認団体ではありません。学類も学年も問わず、作りたいものがある人が集まっています。</p>
    </div>
  </section>

  <section class="activities" id="activities" aria-labelledby="activities-heading">
    <h2 class="section-title" id="activities-heading">基本は、木曜の夜。</h2>
    <div class:list={['moku', { 'moku--no-number': sessionNumber === null }]}>
      {sessionNumber !== null && (
        <p class="moku-number num" aria-hidden="true"><span>#</span>{sessionNumber}</p>
      )}
      <div>
        <h3>もくもく会</h3>
        <p class="meta">週1回程度 / 基本は木曜 <b>18:30</b>-21:00 / 株式会社ゲームシスト</p>
        <p>作りたいものを持ってきて、それぞれ手を動かします。途中参加も途中退出も大丈夫です。{sessionNote}</p>
        <p class="topics-caption">最近の回で話題になったこと</p>
        <ul class="topics">
          <li>Stripe を使った課金機能の実装</li>
          <li>OLTP と OLAP の違い</li>
          <li>LLM エージェントシステムの研究計画</li>
        </ul>
      </div>
    </div>
    <div class="acts">
      <div class="act act--lt">
        <p class="act-number num">5<small>分 / 1人</small></p>
        <div>
          <h3>LT会</h3>
          <p class="meta">不定期 / 飛び入り歓迎</p>
          <p>1人5分で、作ったものを話します。うまくいった話より、</p>
          <p class="act-quote">「何に詰まったか、<br />何を間違えたか」</p>
          <p>を話す場です。</p>
        </div>
      </div>
      <div class="act act--study">
        <h3>勉強会</h3>
        <p class="meta">月1回</p>
        <p>知りたいことを、知っている人が話す形式です。これまでに Claude Code の使い方、git command を扱いました。</p>
      </div>
    </div>
    <p class="activities-more">ほかに、初心者向けプログラミングワークショップや、協賛企業とのプロジェクトも行っています。</p>
  </section>

  <section class="quote" aria-label="代表の言葉">
    <p class="quote-mark" aria-hidden="true">“</p>
    <figure>
      <blockquote><p>「作りたいものはあるけど、作り方が分からない」。その状態のまま来てくれるのが、一番ありがたいです。</p></blockquote>
      <figcaption>{FOUNDER.name}（OneThing 代表・社会工学類）</figcaption>
    </figure>
  </section>

  <section class="join" id="participation" aria-labelledby="join-heading">
    <div class="join-top">
      <h2 id="join-heading">PC1台で、<br />来てください。</h2>
      <p class="join-zero num">0<span>円</span></p>
    </div>
    <ul class="join-facts">
      <li>参加費無料</li>
      <li>入会手続きなし</li>
      <li>学類・学年の指定なし</li>
      <li>1年生歓迎、情報系以外の学類からも</li>
      <li>つくば周辺で働くエンジニアも参加</li>
      <li>不安なら公式X の DM で聞けます</li>
    </ul>
    <div class="join-events" data-link-location="join-events">
      <h3>次の予定</h3>
      {
        upcomingRows.length > 0 ? (
          <ul class="join-event-list">
            {upcomingRows.map((row) => (
              <li>
                <time class="join-event-date" datetime={row.event.start.toISOString()}>
                  {row.date}
                  <small>{row.weekday}</small>
                </time>
                <span class="join-event-title">
                  {row.event.url ? <a href={row.event.url}>{row.event.summary}</a> : row.event.summary}
                  <span>
                    {row.time}
                    {row.event.locationShort && ` / ${row.event.locationShort}`}
                  </span>
                </span>
                {row.marker ? <span class="join-event-today">{row.marker}</span> : <span />}
              </li>
            ))}
          </ul>
        ) : (
          <p class="join-event-empty">次の回は決まり次第、カレンダーに載せます。</p>
        )
      }
      <p class="join-events-updated">
        最終更新 <time datetime={dashboard.fetchedAt.toISOString()}>{formatFetchedAt(dashboard.fetchedAt)}</time>
      </p>
    </div>
    <div class="cta join-cta" data-link-location="join">
      <a class="btn btn-dark" href={SOCIAL_LINKS.luma}>イベント一覧を見る</a>
      <a class="text-link" href="/calender/">カレンダーで見る</a>
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="posts" id="latest-posts" aria-labelledby="posts-heading">
        <h2 id="posts-heading">記事</h2>
        <ul class="link-rows">
          {latestPosts.map((post) => (
            <li>
              <a class="link-row" href={`/blog/${post.id}/`}>
                <strong>{post.data.title}</strong>
                <span>
                  <time datetime={post.data.pubDate.toISOString()}>{formatPostDateLong(post.data.pubDate)}</time>・{post.data.category}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="faq" id="faq" aria-labelledby="faq-heading">
    <h2 id="faq-heading">よくある<br />質問</h2>
    <dl class="faq-list">
      {faqItems.map((item) => (
        <Fragment>
          <dt>{item.question}</dt>
          <dd>{item.answer}</dd>
        </Fragment>
      ))}
    </dl>
  </section>

  <section class="org" id="contact" aria-labelledby="org-heading">
    <h2 id="org-heading">運営とお問い合わせ</h2>
    <div>
      <p>筑波大学の学生メンバーを中心に、イベント企画・広報・企業連携などを分担して運営しています。</p>
      <p>お問い合わせは <a href={SOCIAL_LINKS.x}>公式X</a> の DM へどうぞ。</p>
    </div>
  </section>
</BaseLayout>
