---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCalendarPanel from '../components/EventCalendarPanel.astro';
import { getCalendarDashboard } from '../lib/calendar';
import { NAV_ITEMS, SITE_DESCRIPTION, SITE_NAME_FULL, SOCIAL_LINKS, absoluteUrl } from '../lib/site';

// 構造化データ用にイベントを取る。EventCalendarPanel と同じ関数で、結果はモジュール内でキャッシュされる。
const dashboard = await getCalendarDashboard(12, { sourceIds: ['onething'] });

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME_FULL,
  alternateName: 'OneThing',
  url: absoluteUrl('/'),
  description: SITE_DESCRIPTION,
  foundingDate: '2023',
  areaServed: '茨城県つくば市',
  sameAs: [SOCIAL_LINKS.x, SOCIAL_LINKS.luma, SOCIAL_LINKS.connpass],
};

// Google のイベント リッチリザルト用。日時は ISO 8601 で渡す必要がある。
const eventsJsonLd = dashboard.events.map((event) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.summary,
  startDate: event.start.toISOString(),
  endDate: event.end.toISOString(),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: event.location || '茨城県つくば市',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'つくば市',
      addressRegion: '茨城県',
      addressCountry: 'JP',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: SITE_NAME_FULL,
    url: absoluteUrl('/'),
  },
  ...(event.url ? { url: event.url } : {}),
  ...(event.shortDescription ? { description: event.shortDescription } : {}),
}));

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'プログラミング初心者でも参加できますか？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '参加できます。初心者向けのプログラミングワークショップも開いています。もくもく会は各自が手を動かす場なので、学びはじめの人でも入りやすい形式です。',
      },
    },
    {
      '@type': 'Question',
      name: '参加費はかかりますか？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'かかりません。LT会・勉強会・もくもく会はいずれも参加費無料です。',
      },
    },
    {
      '@type': 'Question',
      name: '筑波大学の学生でなくても参加できますか？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '筑波大学の学生を中心としたコミュニティですが、つくば周辺で活動しているエンジニアの方も参加しています。まずはイベント一覧から気になる回に来てください。',
      },
    },
    {
      '@type': 'Question',
      name: '学類や学年の指定はありますか？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ありません。情報系以外の学類の学生も参加しています。1年生の参加も歓迎です。',
      },
    },
  ],
};
---

<BaseLayout
  title="OneThing｜筑波大学のエンジニアコミュニティ｜もくもく会・LT会・勉強会"
  description={SITE_DESCRIPTION}
  navItems={[...NAV_ITEMS]}
  brandAsHeading
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    {eventsJsonLd.map((event) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(event)} />
    ))}
  </Fragment>

  <section id="onething">
    <h2>OneThingとは</h2>
    <p>
      2023年より活動している、筑波大学のエンジニアコミュニティです。つくば市を拠点に、週1回のもくもく会と、月に数回の勉強会・LT会を開いています。
    </p>
  </section>

  <section id="purpose">
    <h2>OneThingの目的</h2>
    <p>1つの作品を通して次への一歩を踏み出し、仲間と共に挑戦ができる、筑波大学1番のエンジニアコミュニティを目指しています。</p>
  </section>

  <section id="activities">
    <h2>活動内容</h2>
    <ul class="activity-grid">
      <li class="activity-card">
        <div class="activity-card-head">
          <h3>もくもく会</h3>
          <span class="activity-cadence">週1回程度</span>
        </div>
        <p>各自が作りたいものを持ち寄って手を動かす会。途中参加も途中退出もできます。手を止めた雑談では、それぞれの専門に沿った技術の話が出ます。</p>
      </li>
      <li class="activity-card">
        <div class="activity-card-head">
          <h3>勉強会</h3>
          <span class="activity-cadence">月に数回</span>
        </div>
        <p>知りたいことを、知っている人が話す形式。これまでのトピックは Claude Code の使い方と git command。</p>
      </li>
      <li class="activity-card">
        <div class="activity-card-head">
          <h3>LT会</h3>
          <span class="activity-cadence">月に数回</span>
        </div>
        <p>1人5分の持ち時間で、作ったものを話す会。飛び入りの発表も歓迎しています。</p>
      </li>
    </ul>
    <p class="activity-note">
      このほかに、初心者向けプログラミングワークショップと、協賛企業とのプロジェクトがあります。
    </p>
    <EventCalendarPanel variant="overview" heading="直近の活動予定" headingId="top-event-calendar" />
  </section>

  <section id="participation">
    <h2>OneThingへの参加方法</h2>
    <p>
      事前の入会手続きはありません。以下のイベント一覧から気になる回を選んで、当日来てください。
    </p>
    <p>
      <a href={SOCIAL_LINKS.luma}>イベント一覧を見る</a>
    </p>
  </section>

  <section id="faq">
    <h2>よくある質問</h2>
    <dl class="faq-list">
      <dt>プログラミング初心者でも参加できますか？</dt>
      <dd>参加できます。初心者向けのワークショップも開いています。もくもく会は各自が手を動かす場なので、学びはじめの人でも入りやすい形式です。</dd>

      <dt>参加費はかかりますか？</dt>
      <dd>かかりません。LT会・勉強会・もくもく会はいずれも参加費無料です。</dd>

      <dt>筑波大学の学生でなくても参加できますか？</dt>
      <dd>筑波大学の学生を中心としたコミュニティですが、つくば周辺で活動しているエンジニアの方も参加しています。</dd>

      <dt>学類や学年の指定はありますか？</dt>
      <dd>ありません。情報系以外の学類の学生も参加しています。1年生の参加も歓迎です。</dd>
    </dl>
  </section>

  <section id="management">
    <h2>運営体制</h2>
    <p>OneThingは、筑波大学の学生メンバーを中心に、イベント企画・広報・企業連携などを分担して運営しています。</p>
  </section>

  <section id="contact">
    <h2>お問い合わせ</h2>
    <p>
      <a href={SOCIAL_LINKS.x}>公式X（旧Twitter）</a>のDMにてお問い合わせください。
    </p>
  </section>
</BaseLayout>
