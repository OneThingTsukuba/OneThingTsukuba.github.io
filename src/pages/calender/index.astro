---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCalendarPanel from '../../components/EventCalendarPanel.astro';
import { NAV_ITEMS } from '../../lib/site';

---

<BaseLayout
  title="活動カレンダー｜OneThing 筑波大学エンジニアコミュニティ"
  description="OneThing（筑波大学エンジニアコミュニティ）の活動カレンダー。もくもく会・LT会・勉強会の開催日時と会場を掲載しています。参加費無料、初心者歓迎。"
  navItems={[...NAV_ITEMS]}
>
  <section>
    <h1>活動カレンダー</h1>
    <p>もくもく会・LT会・勉強会の予定です。各イベントの詳細と申し込みはイベント一覧から確認できます。</p>
    <EventCalendarPanel variant="detail" heading="OneThing 活動カレンダー" headingId="calendar-page-events" />
  </section>
</BaseLayout>
