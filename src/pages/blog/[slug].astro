---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NAV_ITEMS, SITE_NAME_FULL, absoluteUrl } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 表示はビルド環境のタイムゾーンに引きずられないよう日本時間で固定する。
// 固定しないと、日時付きの pubDate が UTC ビルドで前日にずれる。
const dateFormatter = new Intl.DateTimeFormat('ja-JP', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const formatDate = (date: Date) => dateFormatter.format(date).replaceAll('/', '.');

const postUrl = absoluteUrl(`/blog/${post.id}/`);
// 代表画像。OGP と構造化データで同じものを使う
const heroImageUrl = post.data.heroImage ? absoluteUrl(post.data.heroImage.src) : undefined;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  // canonical と完全に一致させる。末尾スラッシュが無いと別URL扱いになる
  mainEntityOfPage: postUrl,
  ...(heroImageUrl ? { image: [heroImageUrl] } : {}),
  // 書いた個人を author にする。publisher は団体のまま
  author: {
    '@type': 'Person',
    name: post.data.author,
    ...(post.data.authorRole ? { jobTitle: post.data.authorRole } : {}),
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME_FULL,
    url: absoluteUrl('/'),
  },
};
---

<BaseLayout
  title={`${post.data.title}｜OneThing 筑波大学エンジニアコミュニティ`}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.heroImage?.src}
  navItems={[...NAV_ITEMS]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  </Fragment>

  <article class="post">
    <p class="post-back"><a href="/blog/">記事一覧に戻る</a></p>

    <span class="post-meta">
      <span class="post-category">{post.data.category}</span>
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      {post.data.updatedDate && <span class="post-updated">更新 {formatDate(post.data.updatedDate)}</span>}
    </span>

    <h1>{post.data.title}</h1>

    {
      post.data.heroImage && (
        <Image
          class="post-hero"
          src={post.data.heroImage}
          alt={post.data.heroImageAlt ?? ''}
          loading="eager"
        />
      )
    }

    <div class="post-body">
      <Content />
    </div>

    <p class="post-byline">
      この記事は{post.data.authorRole ? ` ${post.data.authorRole}の` : ''}<strong>{post.data.author}</strong>が書きました。
    </p>

    <p class="post-back"><a href="/blog/">記事一覧に戻る</a></p>
  </article>
</BaseLayout>
