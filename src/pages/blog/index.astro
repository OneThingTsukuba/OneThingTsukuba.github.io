---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NAV_ITEMS } from '../../lib/site';

// 新しい順に並べる
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// 日付はビルド環境のタイムゾーンに引きずられないよう日本時間で固定する
const dateFormatter = new Intl.DateTimeFormat('ja-JP', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const formatDate = (date: Date) => dateFormatter.format(date).replaceAll('/', '.');
---

<BaseLayout
  title="記事一覧｜OneThing 筑波大学エンジニアコミュニティ"
  description="OneThing（筑波大学エンジニアコミュニティ）の記事一覧。活動の紹介、勉強会・LT会の開催報告、技術の解説を掲載しています。"
  navItems={[...NAV_ITEMS]}
>
  <section>
    <h1>記事一覧</h1>
    {
      posts.length === 0 ? (
        <p>まだ記事がありません。</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-item">
              <a href={`/blog/${post.id}/`}>
                <span class="post-meta">
                  <span class="post-category">{post.data.category}</span>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                </span>
                <span class="post-title">{post.data.title}</span>
                <span class="post-desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
