---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const navItems = [
  { href: '/', label: 'トップ' },
  { href: '/blog', label: '記事' },
  { href: '/calender', label: 'カレンダー' },
];

// 新しい順に並べる
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const formatDate = (date: Date) =>
  `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
---

<BaseLayout
  title="記事一覧｜OneThing 筑波大学エンジニアコミュニティ"
  description="OneThing（筑波大学エンジニアコミュニティ）の記事一覧。活動の紹介、勉強会・LT会の開催報告、技術の解説を掲載しています。"
  navItems={navItems}
>
  <section>
    <h2>記事一覧</h2>
    {
      posts.length === 0 ? (
        <p>まだ記事がありません。</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-item">
              <a href={`/blog/${post.id}`}>
                <span class="post-meta">
                  <span class="post-category">{post.data.category}</span>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                </span>
                <span class="post-title">{post.data.title}</span>
                <span class="post-desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
