---
import '../styles/global.css';
import {
  SITE_NAME_FULL,
  SOCIAL_LINKS,
  SITE_DESCRIPTION,
  OG_IMAGE_PATH,
  absoluteUrl,
} from '../lib/site';

type NavItem = {
  href: string;
  label: string;
};

interface Props {
  /** <title> にそのまま入る文字列。検索結果の見出しになるので、キーワードを含めて30字前後に。 */
  title: string;
  /** 検索結果とSNSカードの説明文。省略時はサイト既定を使う。 */
  description?: string;
  /** OGP画像のパス。省略時は共通のOGP画像。 */
  ogImage?: string;
  /** og:type。トップは website、記事ページは article。 */
  ogType?: 'website' | 'article';
  navItems?: NavItem[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage = OG_IMAGE_PATH,
  ogType = 'website',
  navItems = [],
} = Astro.props;

// canonical は絶対URLでなければ意味がない。Astro.url はビルド時に astro.config の site を基準に解決される。
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? absoluteUrl('/')).toString();
// フッターの年はビルド時に決まる。ビルド環境は UTC なので、タイムゾーンを日本に固定する。
// 固定しないと元日の 00:00〜08:59 (JST) の間だけ前年が出る。
// なお毎時の cron ビルドは実行を保証しない (GitHub Actions の遅延・破棄、
// 公開リポジトリの60日無活動での自動停止)。年跨ぎ直後の表示は push で確定させる。
const currentYear = new Intl.DateTimeFormat('en-US', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric',
}).format(new Date());
const ogImageUrl = absoluteUrl(ogImage);

const gaInput = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const gaMeasurementId = typeof gaInput === 'string' && /^G-[A-Z0-9]+$/.test(gaInput) ? gaInput : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OGP: X / Slack にURLを貼ったときのカード。ここが無いと白いリンクしか出ない -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME_FULL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@OneThingTsukuba" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- ロゴのキューブマークを favicon に使う (public/favicon.png、元画像は OneThing-logo.jpg)。
         旧 favicon.svg は「1」の文字アイコンで、ロゴ制定前の仮のもの -->
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="theme-color" content="#0B1020" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Google Search Console の所有権確認。消すと登録が外れ、検索の数字が見えなくなる。
         public/google7d2e18f9730f790c.html のファイル方式は所定の場所で見つからず失敗したため、
         全ページに乗るタグ方式に切り替えた -->
    <meta name="google-site-verification" content="GK9IpwWMj_L69LR9hhJU6OlizI9rS6RjJx1PAQpqzv0" />

    <!-- Bing Webmaster Tools の所有権確認。Copilot の引用URL・引用回数が見えるようになる。
         GSC からの Import はアカウント不一致で使えなかったため手動登録した -->
    <meta name="msvalidate.01" content="E0545B0A95948509DE15CD54BE511DF0" />

    {
      gaMeasurementId && (
        <Fragment>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
          <script is:inline define:vars={{ gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            // define:vars は IIFE で包まれるため、gtag は window に明示的に置く
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            window.gtag('js', new Date());
            window.gtag('config', gaMeasurementId);

            const joinDomains = ['luma.com', 'lu.ma', 'connpass.com'];
            document.addEventListener('click', (event) => {
              const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
              if (!link || typeof window.gtag !== 'function') return;
              let host;
              try {
                host = new URL(link.href).hostname;
              } catch {
                return;
              }
              if (!joinDomains.some((domain) => host === domain || host.endsWith(`.${domain}`))) return;
              window.gtag('event', 'join_click', {
                link_domain: host,
                link_location: link.closest('[data-link-location]')?.dataset.linkLocation ?? 'other',
              });
            });
          </script>
        </Fragment>
      )
    }

    <!-- 各ページ固有の構造化データなどを差し込む口 -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>

    <!-- モバイルメニューの状態は属性2つで表す。
         data-nav-enhanced: JS がリスナーを張り終えたか。立つまで CSS は
           ナビを開いたまま表示し、ボタンを隠す。JS が落ちてもリンクに到達できる
         data-nav-open: 開閉状態そのもの。CSS の表示と aria-expanded の
           両方をここから導出する -->
    <header class="site-header" data-nav-open="false">
      <div class="site-header-inner">
        <p class="header-title">
          <a href="/">
            {/* alt は空にする。直後に「OneThing」のテキストがあるので、
                alt を入れると読み上げが「OneThing OneThing」と二重になる */}
            <img class="header-logo" src="/images/logo-mark.png" alt="" width="447" height="512" />
            <span class="header-text">
              <span class="main-title">OneThing</span>
              <span class="sub-title">-筑波大学エンジニアコミュニティ-</span>
            </span>
          </a>
        </p>
        {
          navItems.length > 0 && (
            <Fragment>
              {/* 768px 以下でだけ出るハンバーガー。48x48 は指で押せる最小サイズ (Apple HIG は44pt) */}
              <button
                class="nav-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="site-nav"
                aria-label="メニューを開く"
              >
                <span class="nav-toggle-bar" aria-hidden="true" />
                <span class="nav-toggle-bar" aria-hidden="true" />
                <span class="nav-toggle-bar" aria-hidden="true" />
              </button>
              <nav class="site-nav" id="site-nav" aria-label="メインナビゲーション">
                <ul>
                  {navItems.map((item) => (
                    <li>
                      <a href={item.href}>{item.label}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </Fragment>
          )
        }
      </div>
    </header>

    <main class="site-main" id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <p class="site-footer-name">{SITE_NAME_FULL}</p>
        <ul class="site-footer-links" data-link-location="footer">
          <li><a href={SOCIAL_LINKS.x}>公式X</a></li>
          <li><a href={SOCIAL_LINKS.luma}>Luma</a></li>
          <li><a href={SOCIAL_LINKS.connpass}>connpass</a></li>
          <li><a href={SOCIAL_LINKS.github}>GitHub</a></li>
        </ul>
        <p>お問い合わせは公式XのDMにて。</p>
        <p>&copy; {currentYear} OneThing All Rights Reserved.</p>
      </div>
    </footer>

    <script>
      // モバイルメニューの開閉。状態は header の data-nav-open ただ1つに持たせ、
      // CSS の表示切り替えと aria-expanded の両方をそこから導出する。
      // 状態を2箇所に持つと、片方だけ更新して見た目と支援技術がズレる
      const header = document.querySelector<HTMLElement>('.site-header');
      const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.getElementById('site-nav');

      if (header && toggle && nav) {
        const setOpen = (open: boolean) => {
          header.dataset.navOpen = String(open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
        };

        toggle.addEventListener('click', () => {
          setOpen(header.dataset.navOpen !== 'true');
        });

        // 同一ページ内アンカー (/#contact) は遷移が起きないので、
        // 閉じる処理を入れないとメニューが開いたまま残って本文を隠す
        nav.addEventListener('click', (event) => {
          if ((event.target as HTMLElement).closest('a')) {
            setOpen(false);
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && header.dataset.navOpen === 'true') {
            setOpen(false);
            toggle.focus();
          }
        });

        // 開いたまま横向きにするとデスクトップ幅になり、ボタンが消えて閉じられなくなる。
        // CSS と同じ (max-width: 768px) を使う。JS 側だけ 769px にすると、
        // 768px と 769px の間の小数幅で両者の判定が食い違う
        window.matchMedia('(max-width: 768px)').addEventListener('change', (event) => {
          if (!event.matches) {
            setOpen(false);
          }
        });

        // ここまで全て登録できて初めてボタンを出す。
        // CSS はこのフラグが立つまでナビを開いたまま表示し続けるので、
        // JS が落ちてもリンクには到達できる
        setOpen(false);
        header.dataset.navEnhanced = 'true';
      }
    </script>
  </body>
</html>
